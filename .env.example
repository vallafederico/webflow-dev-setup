VERCEL_URL="{VERCEL DEPLOYED URL}"
# Optional: override where public/ assets are loaded from (defaults: dev server in dev, VERCEL_URL in production)
# PUBLIC_ASSET_ORIGIN="http://localhost:6545"
USE_SSL=true
# Optional: hosts accepted for ?js= / ?css= branch previews on .webflow.io (default ".vercel.app").
# Tighten to your team's preview URLs, e.g. "-your-team.vercel.app".
# PREVIEW_HOST_SUFFIX=".vercel.app"
VERCEL_DEPLOY_HOOK="{VERCEL DEPLOY HOOK}"